{
  "sourceLanguage": "en",
  "strings": {
    "**%lld** manga titles": {
      "comment": "Total distinct manga titles in the collection badge. Preserve Markdown emphasis around the number so it can use a larger font; not the number of owned volumes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "**%lld** manga"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "**%lld** manga"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "**%lld** manga"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "**%lld** mangas"
                }
              }
            }
          }
        }
      }
    },
    "%lld manga titles in your collection": {
      "comment": "Full accessibility label for the total number of manga titles in the complete collection snapshot.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
