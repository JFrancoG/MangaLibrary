            "value": "%lld más"
          }
        }
      }
    },
    "%lld more on iPhone": {
      "comment": "Number of eligible readings not shown in the current visible prefix, available in the iPhone app.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
