              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld más en el iPhone"
                }
              }
            }
          }
        }
      }
    },
    "%lld more on iPhone. Updated %@": {
      "comment": "VoiceOver description of the reading widget footer. Includes the number of remaining readings and the already formatted update date/time; preserve both values and their order.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more on iPhone. Updated %@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld more on iPhone. Updated %@"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld más en el iPhone. Actualizado %@"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld más en el iPhone. Actualizado %@"
                }
              }
            }
          }
        }
      }
    },
    "%lld of %lld volumes owned": {
      "comment": "Full accessibility label for the ownership count and known series total; neither number is reading progress.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumes owned: %1$lld of %2$lld"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomos en propiedad: %1$lld de %2$lld"
          }
        }
      }
    },
    "%lld volumes": {
      "comment": "Compact visible ownership count in the medium widget at large text sizes. Accessibility says volumes owned.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld volume"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld volumes"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld tomo"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld tomos"
                }
              }
            }
          }
        }
      }
    },
    "%lld volumes owned": {
      "comment": "Ownership count when the series total is unknown. No denominator is invented.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld volume owned"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld volumes owned"
                }
              }
            }
          }
        },
