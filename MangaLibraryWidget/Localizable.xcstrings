              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld mangas en tu colección"
                }
              }
            }
          }
        }
      }
    },
    "%lld more": {
      "comment": "Compact remaining reading count at accessibility text sizes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld more"
          }
