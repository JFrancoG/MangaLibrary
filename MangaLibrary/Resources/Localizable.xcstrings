        "es" : { "stringUnit" : { "state" : "translated", "value" : "El catálogo está vacío" } }
      }
    },
    "The catalog is temporarily unavailable." : {
      "comment" : "Safe description when a catalog failure has no more specific category.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The catalog is temporarily unavailable." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El catálogo no está disponible temporalmente." } }
      }
    },
    "The network request timed out." : {
      "comment" : "Safe description for a network timeout.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The network request timed out." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La solicitud de red ha agotado el tiempo de espera." } }
      }
    },
    "The server response has an unexpected format." : {
      "comment" : "Safe description when required catalog fields or metadata do not match the contract.",
