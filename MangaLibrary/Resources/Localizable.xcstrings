        "en" : { "stringUnit" : { "state" : "translated", "value" : "The server response has an unexpected format." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La respuesta del servidor tiene un formato inesperado." } }
      }
    },
    "The server returned an invalid response." : {
      "comment" : "Safe description when URL loading does not return an HTTP response.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The server returned an invalid response." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El servidor ha devuelto una respuesta no válida." } }
      }
    },
    "The server returned status code %lld." : {
      "comment" : "Safe description for an unexpected HTTP status code.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The server returned status code %lld." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El servidor ha respondido con el código %lld." } }
      }
    },
    "There is no internet connection." : {
      "comment" : "Safe description when URL loading reports no internet connection.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "There is no internet connection." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay conexión a internet." } }
