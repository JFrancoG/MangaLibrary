      "comment" : "Heading for the synopsis section on manga detail.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Synopsis" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sinopsis" } }
      }
    },
    "The catalog is empty" : {
      "comment" : "Title for a successful first catalog page with no manga.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The catalog is empty" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El catálogo está vacío" } }
