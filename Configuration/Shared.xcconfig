// Optional local values are loaded first so they cannot relax the mandatory
// policies declared below. Local.xcconfig is ignored by Git.
#include? "Local.xcconfig"

// Shared build policy for every target and configuration.
GCC_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_DEFAULT_ACTOR_ISOLATION = nonisolated
ASSETCATALOG_COMPILER_GENERATE_ASSET_SYMBOL_FRAMEWORKS = SwiftUI
OTHER_DOCC_FLAGS = $(inherited) --warnings-as-errors
